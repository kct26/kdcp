{
 "mutants": [
  {
   "name": "stack instead of a queue",
   "edits": [
    [
     "queue<long long> line;",
     "stack<long long> line;"
    ],
    [
     "(line.empty() ? -1 : line.front())",
     "(line.empty() ? -1 : line.top())"
    ]
   ]
  },
  {
   "name": "empty line reports 0",
   "edits": [
    [
     "(line.empty() ? -1 : line.front())",
     "(line.empty() ? 0 : line.front())"
    ]
   ]
  }
 ]
}